{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rumpelstiltskinai",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "DATABASE_PROVIDER": "d1",
    "VITE_APP_URL": "https://rumpelstiltskinai.org",
    "VITE_APP_NAME": "rumpelstiltskin ai",
    "VITE_APP_DESCRIPTION": "Create AI Rumpelstiltskin dance videos with cinematic fairy-tale scenes and original prompts.",
    "VITE_APP_LOGO": "/logo.svg",
    "VITE_DEFAULT_LOCALE": "en"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rumpelstiltskinai",
      "database_id": "cdc01709-03ba-4147-bc0b-edbb152f4849",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "routes": [{ "pattern": "rumpelstiltskinai.org", "custom_domain": true }]
}
